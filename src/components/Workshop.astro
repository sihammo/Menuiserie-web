---
const shots = [
  { src: '/images/chevets.jpg', alt: 'هياكل طاولات جانبية مرصوصة في الورشة قبل الصباغة', note: 'هياكل تستنى الصباغة' },
  { src: '/images/atelier.jpg', alt: 'آلة النشر وألواح الصنوبر في الورشة', note: 'هنا يتقص كل لوح' },
  { src: '/images/sommier.jpg', alt: 'قاعدة سرير من الصنوبر الطبيعي', note: 'صنوبر خام، قبل التغليف' },
];
---
<section class="workshop" aria-labelledby="atelier-titre">
  <div class="wrap">
    <h2 id="atelier-titre">صور من الورشة، ماشي من الأنترنت</h2>
    <div class="grid">
      {shots.map((s) => (
        <figure>
          <img src={s.src} alt={s.alt} loading="lazy" width="600" height="800" />
          <figcaption class="hand">{s.note}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .workshop{background:var(--shadow);color:var(--kraft-light);padding:7rem 0}
  h2{color:var(--kraft-light);font-size:clamp(1.9rem,4vw,3rem);max-width:20ch}
  .grid{margin-top:3rem;display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:1.5rem;align-items:end}
  figure:nth-child(2){margin-bottom:3rem}
  img{width:100%;aspect-ratio:3/4;object-fit:cover;filter:sepia(.15) saturate(.9)}
  figcaption{color:#e9866f;font-size:1.4rem;margin-top:.6rem}
  @media (max-width:760px){.grid{grid-template-columns:1fr}figure:nth-child(2){margin:0}}
</style>
