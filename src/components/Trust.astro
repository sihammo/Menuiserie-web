---
import { listReviews, listProducts } from '../lib/store.js';
import stats from '../data/stats.json';
const names = Object.fromEntries(listProducts().map((p) => [p.slug, p.name]));
const real = listReviews().slice(0, 20).map((r) => ({ ...r, product: names[r.slug] || '' }));
// نعاودو القايمة باش الشريط يعمر العرض، ونعاودوها مرة أخرى للحلقة بلا قطع (النسخة الثانية مخفية على القارئات)
const base = real.length ? Array.from({ length: Math.max(1, Math.ceil(8 / real.length)) }, () => real).flat() : [];
const seconds = Math.max(30, base.length * 6);
const promises = [
  ['نضمنولك أفضل خدمة', 'من الطلب حتى التسليم، نتصلو بيك ونتابعو معاك.'],
  ['نضمنولك أفضل منتوج', 'خشب مختار وخدمة باليد، قطعة بقطعة.'],
  [`توصيل ${stats.deliveryText}`, 'لـ 69 ولاية، والكاميو يوصلك للباب.'],
];
---
<section class="trust" aria-labelledby="trust-titre">
  <div class="wrap">
    <h2 id="trust-titre">ليش تثق فينا</h2>
    <ul class="promises">
      {promises.map(([t, d]) => (
        <li><span class="ck" aria-hidden="true">✓</span><div><b>{t}</b><p>{d}</p></div></li>
      ))}
    </ul>
  </div>

  <div class="rv-head wrap"><h3>آراء الزبائن</h3></div>
  {base.length > 0 ? (
    <div class="marquee" style={`--dur:${seconds}s`} aria-label="آراء الزبائن">
      <div class="lane">
        {[0, 1].map((copy) => (
          <ul class="set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {base.map((r) => (
              <li class="card">
                <div class="stars" aria-label={`${r.stars} من 5`}><span>{'★'.repeat(r.stars)}</span><span class="off">{'★'.repeat(5 - r.stars)}</span></div>
                <p>{r.text}</p>
                <footer><b>{r.name}</b>{r.product && <small>{r.product}</small>}</footer>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  ) : (
    <div class="wrap"><p class="empty">اشريت عندنا؟ شاركنا رايك في صفحة المنتوج، وبان هنا.</p></div>
  )}
</section>
<style>
  .trust{padding:5rem 0 5.5rem;background:var(--kraft-light)}
  h2{font-size:clamp(1.8rem,3vw,2.6rem);margin-bottom:2rem}
  .promises{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
  .promises li{display:flex;gap:1rem;align-items:flex-start;background:var(--kraft);padding:1.3rem 1.4rem;box-shadow:0 14px 24px -18px rgba(40,25,10,.6)}
  .ck{flex:none;width:2.2rem;height:2.2rem;border-radius:50%;background:var(--walnut);color:var(--kraft-light);display:grid;place-items:center;font-weight:700}
  .promises b{font-family:var(--display);font-size:1.2rem;color:var(--shadow)}
  .promises p{font-size:.95rem;line-height:1.6;margin-top:.2rem}
  .rv-head{margin-top:4rem}.rv-head h3{font-size:1.5rem;margin-bottom:1.2rem}
  .marquee{overflow:hidden;direction:ltr;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
  .lane{display:flex;width:max-content;animation:slide var(--dur) linear infinite}
  .marquee:hover .lane,.marquee:focus-within .lane{animation-play-state:paused}
  .set{list-style:none;padding:0;margin:0;display:flex;gap:1.1rem;padding-inline-end:1.1rem}
  .card{direction:rtl;width:min(20rem,78vw);flex:none;background:var(--kraft);padding:1.2rem 1.3rem;display:flex;flex-direction:column;gap:.5rem;box-shadow:0 14px 24px -18px rgba(40,25,10,.6)}
  .stars{color:#c98a00;letter-spacing:.1em}.stars .off{color:#b9a47c}
  .card p{font-size:1rem;line-height:1.65;flex:1}
  .card footer{display:flex;justify-content:space-between;gap:.6rem;font-size:.9rem;align-items:baseline}
  .card small{opacity:.7}
  .empty{opacity:.75}
  @keyframes slide{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){.lane{animation:none}.marquee{overflow-x:auto}}
  @media (max-width:820px){.promises{grid-template-columns:1fr}.trust{padding:3.5rem 0 4rem}}
</style>
