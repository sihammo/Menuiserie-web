---
import { wilayaList } from '../lib/orders.js';
const { slug } = Astro.props;
---
<form class="order" id="order-form" novalidate>
  <input type="hidden" name="product" value={slug} />
  <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="row2">
    <label>الاسم<input name="firstName" required autocomplete="given-name" /></label>
    <label>اللقب<input name="lastName" required autocomplete="family-name" /></label>
  </div>
  <label>رقم الهاتف<input name="phone" type="tel" inputmode="tel" dir="ltr" placeholder="05 / 06 / 07 XX XX XX XX" required autocomplete="tel" /></label>
  <div class="row2">
    <label>الولاية
      <select name="wilaya" required>
        <option value="">اختار الولاية</option>
        {wilayaList.map((w) => <option value={w.code}>{String(w.code).padStart(2, '0')} - {w.name}</option>)}
      </select>
    </label>
    <label>الكمية<input name="qty" type="number" min="1" max="20" value="1" inputmode="numeric" /></label>
  </div>
  <label>العنوان (البلدية، الحي، الشارع)<input name="address" required autocomplete="street-address" /></label>
  <label>ملاحظة (اختياري)<textarea name="note" rows="2" placeholder="المقاس، اللون…"></textarea></label>
  <p class="err" role="alert" hidden></p>
  <button class="btn" type="submit">أكّد الطلب</button>
  <p class="small">ما تخلصش دوك. نتصلو بيك لتأكيد الطلب والتوصيل، والثمن يتأكد معاك.</p>
</form>
<style>
  .order{display:grid;gap:1rem}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  label{display:grid;gap:.3rem;font-weight:500;font-size:.95rem}
  input,select,textarea{font:inherit;padding:.7rem .8rem;border:1.5px solid #8c6b45;background:#fbf6ea;color:var(--graphite);border-radius:3px;width:100%}
  input:focus,select:focus,textarea:focus{outline:3px solid var(--mark);outline-offset:1px}
  .hp{position:absolute;inset-inline-start:-9999px;height:0;opacity:0}
  .err{color:var(--mark);font-weight:600}
  .btn{border:0;cursor:pointer;font-size:1.2rem;padding:1rem}
  .btn[disabled]{opacity:.6;cursor:wait}
  .small{font-size:.85rem;opacity:.75}
  @media (max-width:520px){.row2{grid-template-columns:1fr}}
</style>
<script>
  const form = document.getElementById('order-form') as HTMLFormElement;
  const err = form.querySelector('.err') as HTMLElement;
  const btn = form.querySelector('button') as HTMLButtonElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    btn.disabled = true; btn.textContent = 'نبعثو الطلب…';
    try {
      const res = await fetch('/api/orders', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.id) { location.href = `/commande/${data.id}`; return; }
      err.textContent = data.error || 'صرات مشكلة، عاود أو اتصل بينا 0698 07 42 63'; err.hidden = false;
    } catch { err.textContent = 'ما كاينش كونيكسيون، عاود أو اتصل بينا 0698 07 42 63'; err.hidden = false; }
    btn.disabled = false; btn.textContent = 'أكّد الطلب';
  });
</script>
